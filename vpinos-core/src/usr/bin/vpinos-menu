#!/bin/sh
# The VPinOS console menu. Two front ends over the same actions
# (/usr/libexec/vpinos/vpinos-menu-actions):
#
#   vpinos_menu.py        the Textual menu -- in kmscon (tty1's console)
#                         or any terminal that can draw it
#   vpinos-menu-classic   the plain POSIX sh menu -- on the Linux text
#                         console (TERM=linux: the getty@tty1 fallback on
#                         fbcon), or without python3-textual
#
# VPINOS_MENU=classic forces the plain one (debugging).
#
# Started by /etc/profile.d/vpinos-menu.sh at every console login, and
# re-exec'd by both menus after Update VPinOS, so an updated menu runs
# the new version.

# Puts VPX's VR setting back if the VR server isn't running any more
# (stopped by a reboot or a crash rather than VR > Stop) -- otherwise
# every table would keep trying to start in VR with no server there.
/usr/libexec/vpinos/vpinos-vr.sh reconcile

case "$TERM" in
    linux | dumb | "") ;;
    *)
        # -B: no __pycache__ (root-owned /usr/libexec, and not wanted).
        if [ "$VPINOS_MENU" != classic ] && python3 -B -c 'import textual' 2>/dev/null; then
            exec python3 -B /usr/libexec/vpinos/vpinos_menu.py
        fi
        ;;
esac
exec /usr/libexec/vpinos/vpinos-menu-classic
