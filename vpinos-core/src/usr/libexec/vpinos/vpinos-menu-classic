#!/bin/sh
# The plain POSIX sh menu: what /usr/bin/vpinos-menu runs where the
# Textual one (vpinos_menu.py) can't -- the Linux text console
# (TERM=linux: the getty@tty1 fallback on fbcon when kmscon fails), or
# a system without python3-textual. Same items, same numbers, and the
# same actions: everything an item does is in vpinos-menu-actions,
# sourced below, so this file only draws the menus and asks.
#
# A Textual (python3-textual) rewrite of this menu was tried and
# reverted in 1.0 -- it never rendered correctly on the real Linux
# virtual console (TERM=linux/fbcon): a confirmed, still-open upstream
# bug (https://github.com/Textualize/rich/issues/3231) means
# Rich/Textual's Unicode box-drawing borders don't render reliably
# there. tty1's console is kmscon since core 1.1.12, where the Textual
# menu works; this one stays plain sh/echo for fbcon.

VPINOS_MENU_LIB=1
. /usr/libexec/vpinos/vpinos-menu-actions

# Raw ANSI art + bordered version/IP line for the main menu's header --
# deliberately NOT shared with /usr/libexec/vpinos/vpinos-banner.sh (the
# identical-looking banner shown on SSH login via
# /etc/update-motd.d/00-vpinos-banner): kept as two independent,
# duplicated copies on purpose rather than one calling the other, so
# this file has no runtime dependency on another script existing/being
# installed at a specific path. A quoted heredoc so the embedded escape
# sequences pass through byte-for-byte with zero shell interpretation
# (dash's own echo/printf escape handling is not portable, so this
# sidesteps that entirely). Uses only standard 16-color SGR codes
# (30-37/40-47/90-97), the same basic color mechanism `ls --color`/
# `dmesg` already rely on -- confirmed reliable on the real Linux
# console in a way this file's own header comment notes fancy Unicode
# box-drawing was NOT (the Textual/Rich rewrite that was tried and
# reverted). If the art/version/IP format ever needs to change, update
# both this function and vpinos-banner.sh.
print_logo() {
    cat <<'EOF'
[40m[30m▄[47m[97m▄[107m[37m░[47m[97m▄[107m[37m░[40m[30m▄[40m  [40m▄[97m▄[107m[30m   ▄[37m░░[30m      [40m[97m▄[37m▄[30m▄[107m   [40m▄▄▄▄▄▄▄▄▄▄▄[96m▄▄[46m▄▄▄▄▄[40m▄▄[30m▄[96m▄▄[106m[30m     [36m░[30m [40m[96m▄[30m▄[0m
[40m[30m [40m▄[107m   [40m[97m▄[30m▄▄[97m▄[107m[30m   [40m▄[97m▄[107m[30m   ▄▄▄    [40m[97m▄▄▄[30m▄[97m▄▄▄▄▄▄▄▄[30m▄▄[106m[36m░░░[30m▄▄▄▄[36m░░░[40m[30m▄[106m[36m░░░[30m▄▄▄▄▄▄▄[40m▄[0m
[40m[30m [40m▄[107m▄[37m░░░[40m[30m▄[97m▄[107m[37m░░[30m [40m▄▄[107m  [37m░[40m[97m▄▄▄▄[107m[37m░░[30m [40m▄[107m   [40m▄[107m   ▄▄    [40m[96m▄[106m[36m▒▒░[40m[30m▄▄▄[90m▄[106m[36m▒▒░[40m[30m▄[106m[36m▒▒▒▒▒▒▒[40m▄▄[30m▄[40m [0m
[40m[30m  [40m▄[107m[94m░[34m░░[40m[37m▄[107m[34m░░[30m▄[40m▄▄[97m▄[107m[94m░░░[30m▄▄▄▄▄▄[40m▄[97m▄[107m[94m░░[30m▄[37m░[94m░░[40m[30m▄▄▄[107m[94m░░░[40m[30m▄[106m[34m▒░░[40m[30m▄▄▄▄[106m[36m▄[34m▒▒[30m▄[40m▄▄[106m▄▄[46m▄▄▄[106m[34m▒▒▒[40m[30m▄[40m [0m
[40m[30m  [40m▄[47m▄[106m[35m░░░░[107m[30m▄[40m▄▄▄[107m[94m▒▒▒[47m[30m▄[40m▄▄▄▄▄▄▄[107m[94m▒▒▒[40m[30m▄[107m[94m▒▒▒[40m[30m▄▄[90m▄[107m[94m▒▒[47m[97m▄[40m[30m▄[104m[36m░░░░░░░░░[106m[34m▒[40m[30m▄[104m[36m░░░░░░░░░[30m▄[40m▄[40m [0m
[40m[30m   [40m▄[107m▄▄▄▄[40m▄▄▄▄[107m▄▄▄[40m▄▄▄▄▄▄▄▄[107m▄▄▄[47m▄[107m▄▄[96m▄[40m[30m▄▄[107m▄▄▄[40m▄▄▄[106m▄▄▄▄▄▄▄[40m▄▄[106m▄▄▄▄▄▄▄▄▄[40m▄▄[40m  [0m
[40m[30m    [40m▄[104m▄▄▄[46m▄▄▄▄[106m▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄[40m[96m▄[106m[30m▄[36m▒[40m[30m▄[104m[36m░[40m[30m▄[106m▄▄▄▄▄▄▄▄▄▄▄▄▄▄[46m▄▄▄▄[104m▄▄▄▄[40m▄[40m    [0m
[40m[30m                          [40m▄[106m▄[40m[96m▄[30m▄▄[104m[36m░[40m[30m▄[40m                           [0m
[40m[30m                           [40m▄▄[106m▄[46m▄[40m▄▄[40m                           [0m
EOF
    # os-release is sourced in a subshell so it can't leak/clobber any
    # variable in the caller. `hostname -I` (capital I, the
    # `hostname` package's own flag, not iproute2) lists every assigned
    # address space-separated; first one is enough for an at-a-glance
    # cabinet IP, and it's empty (not an error) before DHCP has
    # completed or with no cable/Wi-Fi connected, so that's handled
    # explicitly rather than printing a blank value.
    # vpinos-core's version is the VPinOS version (it moves with every
    # update); /etc/os-release's VERSION_ID only names the ISO the cabinet
    # was installed from, so it's just the fallback.
    ver=$(dpkg-query -W -f='${Version}' vpinos-core 2>/dev/null)
    [ -z "$ver" ] && ver=$(. /etc/os-release 2>/dev/null; echo "$VERSION_ID")
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -z "$ip" ] && ip="not connected"

    # Bordered, centered under the logo -- plain ASCII (+/-/|), not box-
    # drawing Unicode, deliberately: same reasoning as the art above
    # avoiding Rich/Textual's box-drawing glyphs, zero risk instead of
    # unverified risk. Width matches the logo's own visible width (62
    # columns, confirmed via the art above -- every line is the same
    # width) so the frame lines up edge-to-edge with it rather than
    # floating at some unrelated size. Version and IP are separate rows
    # (not one combined line) and each centered independently, since
    # they're two distinct pieces of information, not one value.
    left_label="Version: "
    left="${left_label}${ver}"
    right_label="IP: "
    right="${right_label}${ip}"
    width=60
    leftcol=8
    rightcol=$((width - ${#right} + 1 - 8))
    # Overlaid directly onto the logo's own second-to-last row (not a
    # separate line below it) via plain VT100 cursor positioning --
    # CSI nA (cursor up n rows) and CSI nG (move to column n, same
    # row) -- ordinary ANSI cursor control, not Unicode, so it's no
    # less reliable on the real console than the color codes already
    # used throughout this art. \033[0m resets color first: that row
    # is black-on-black at this position in the original art, which
    # would otherwise make this text invisible without it. Labels red
    # (31), values bright white (97) for contrast. leftcol=8 (7-space
    # indent from column 1) and rightcol subtracts 10 from the plain
    # right-aligned position -- both fixed offsets from their earlier
    # flush-left/flush-right placement, not computed from the art's
    # own content. Ends by moving back down and to column 1 so
    # whatever prints next (menu options, etc.) resumes on a fresh
    # line below the logo, not mid-overlay.
    printf '\033[2A\033[%dG\033[0m\033[31m%s\033[97m%s' "$leftcol" "$left_label" "$ver"
    printf '\033[%dG\033[31m%s\033[97m%s' "$rightcol" "$right_label" "$ip"
    printf '\033[0m\033[2B\033[1G\n'
}

# Reads a menu choice. `read` fails at end of input (the console went
# away), and an endless loop of "Invalid option" on a dead tty helps
# nobody, so that ends the menu.
choose() {
    printf "Select an option: "
    read -r choice || exit 0
}

invalid() {
    echo "Invalid option"
    sleep 1
}

# A setter's messages stay up briefly, or until Enter after a refusal.
after_set() {
    if [ "$1" = 3 ]; then
        pause
    else
        sleep 2
    fi
}

# To add a program here, see the `manage-boot-programs` skill in
# notes/skills/ -- it walks through this list, the Textual menu's, the
# action, the matching case arm in /etc/profile.d/vpinos-menu.sh, the
# audit check, and the docs together.
boot_mode_submenu() {
    while true; do
        clear
        cur=$(cat /etc/vpinos/boot-mode 2>/dev/null)
        [ -z "$cur" ] && cur=menu
        print_logo
        echo "      Boot on startup"
        echo "=============================="
        echo "Currently: $cur"
        echo
        echo "1) VPinOS menu (default)"
        echo "2) VPinFE"
        echo "q) Cancel, no change"
        echo "=============================="
        choose
        case "$choice" in
            1) action_set_boot_mode menu; after_set $?; return ;;
            2) action_set_boot_mode vpinfe; after_set $?; return ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

gpu_driver_submenu() {
    while true; do
        clear
        cur=$(cat /etc/vpinos/gpu-driver 2>/dev/null)
        [ -z "$cur" ] && cur=default
        print_logo
        echo "         GPU Driver"
        echo "=============================="
        echo "Currently: $cur"
        echo
        echo "1) Default (open-source Mesa/NVK)"
        echo "2) NVIDIA proprietary"
        echo "q) Cancel, no change"
        echo "=============================="
        choose
        case "$choice" in
            1) action_set_gpu_driver default; after_set $?; return ;;
            2) action_set_gpu_driver nvidia; after_set $?; return ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

# Display name for /etc/vpinos/console-rotation's value (fbcon's own
# numbering -- see vpinos-console-rotation.sh).
console_rotation_name() {
    case "$(cat /etc/vpinos/console-rotation 2>/dev/null)" in
        3) echo "90 Left" ;;
        1) echo "90 Right" ;;
        *) echo "normal" ;;
    esac
}

console_rotation_submenu() {
    while true; do
        clear
        print_logo
        echo "       Console Rotation"
        echo "=============================="
        echo "Currently: $(console_rotation_name)"
        echo
        echo "1) Normal (landscape, default)"
        echo "2) 90 Left (portrait)"
        echo "3) 90 Right (portrait)"
        echo "q) Cancel, no change"
        echo "=============================="
        choose
        case "$choice" in
            1) action_set_console_rotation 0; return ;;
            2) action_set_console_rotation 3; return ;;
            3) action_set_console_rotation 1; return ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

# Everything that configures the cabinet rather than runs/tests it.
setup_submenu() {
    while true; do
        clear
        print_logo
        echo "            Setup"
        echo "=============================="
        gcur=$(cat /etc/vpinos/gpu-driver 2>/dev/null)
        [ -z "$gcur" ] && gcur=default
        echo "1) Console Rotation: $(console_rotation_name)"
        echo "2) GPU Driver: $gcur"
        echo "3) VPinOS Configuration"
        echo "4) Network Settings"
        echo "5) VPXConfig (Advanced VPinball Configuration)"
        echo "6) VPinFE Map Controls"
        if settings_kept; then
            bcur=$(cat /etc/vpinos/boot-mode 2>/dev/null)
            [ -z "$bcur" ] && bcur=menu
            echo "7) Boot on startup: $bcur"
        fi
        echo "q) Back"
        echo "=============================="
        choose
        case "$choice" in
            1) console_rotation_submenu ;;
            2) gpu_driver_submenu ;;
            3) action_vpinos_config ;;
            4) action_network ;;
            5) action_vpxconfig ;;
            6) action_vpinfe_map_controls ;;
            7) if settings_kept; then boot_mode_submenu; else invalid; fi ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

ssh_password_auth_submenu() {
    while true; do
        clear
        if [ -e /etc/ssh/sshd_config.d/99-vpinos-live-testing.conf ]; then
            cur=on
        else
            cur=off
        fi
        print_logo
        echo "  SSH Password Authentication"
        echo "=============================="
        echo "Currently: $cur"
        echo
        echo "1) Enable"
        echo "2) Disable"
        echo "q) Cancel, no change"
        echo "=============================="
        choose
        case "$choice" in
            1) action_set_ssh_password_auth on; after_set $?; return ;;
            2) action_set_ssh_password_auth off; after_set $?; return ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

# Things you run to try the cabinet out rather than configure it.
# VPinFE itself lives here on a live session (there's nothing else to
# reach it from), but is promoted to its own top-level option on an
# installed system.
testing_submenu() {
    while true; do
        clear
        print_logo
        echo "           Testing"
        echo "=============================="
        echo "1) Launch VPinball Example Table"
        if ! is_installed; then
            echo "2) VPinFE"
            if [ -e /etc/ssh/sshd_config.d/99-vpinos-live-testing.conf ]; then
                sshacur=on
            else
                sshacur=off
            fi
            echo "3) SSH Password Authentication: $sshacur"
        fi
        echo "q) Back"
        echo "=============================="
        choose
        case "$choice" in
            1) action_example_table ;;
            2) if is_installed; then invalid; else action_testing_vpinfe; fi ;;
            3) if is_installed; then invalid; else ssh_password_auth_submenu; fi ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

tools_submenu() {
    while true; do
        clear
        print_logo
        echo "            Tools"
        echo "=============================="
        if [ "$(dpkg --print-architecture)" != amd64 ]; then
            estate=" (amd64 only)"
        elif vpx_editor_installed; then
            estate=""
        else
            estate=" (not installed)"
        fi
        echo "1) System Info (Debug)"
        echo "2) VPX Editor$estate"
        if [ "$(persistence_state)" = saving ]; then
            saved=1
            echo "3) Reset Saved Settings"
        else
            saved=0
        fi
        echo "q) Back"
        echo "=============================="
        choose
        case "$choice" in
            1) action_sysinfo ;;
            2) action_vpx_editor ;;
            3)
                if [ "$saved" = 0 ]; then
                    invalid
                elif confirm "Clear all saved settings on this USB stick and reboot?"; then
                    action_reset_saved_settings
                else
                    log "selected tools/reset-saved-settings, cancelled"
                fi
                ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

vr_setup_submenu() {
    while true; do
        clear
        print_logo
        echo "          VR Setup"
        echo "=============================="
        if ! is_installed; then
            echo "Live USB: VR components are lost on reboot."
        fi
        if vr_installed; then
            vstate="installed"
            echo "WiVRn $(dpkg-query -W -f='${Version}' wivrn 2>/dev/null) -- the headset's WiVRn"
            echo "app must be this same version."
        else
            vstate="not installed"
        fi
        echo
        gcur=$(cat /etc/vpinos/gpu-driver 2>/dev/null)
        [ -z "$gcur" ] && gcur=default
        echo "1) GPU Driver: $gcur"
        echo "2) Install VR components ($vstate)"
        echo "q) Back"
        echo "=============================="
        choose
        case "$choice" in
            # Same submenu as Setup > GPU Driver -- a second way in for
            # VR-only users (NVENC needs the proprietary driver).
            1) gpu_driver_submenu ;;
            2) action_vr_install ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

vr_submenu() {
    while true; do
        clear
        print_logo
        echo "              VR"
        echo "=============================="
        if vr_installed; then
            vrok=1
            echo "Components: installed"
            /usr/libexec/vpinos/vpinos-vr.sh status
        else
            vrok=0
            echo "Components: not installed (see Setup)"
        fi
        echo
        echo "1) Setup"
        echo "2) Start VR server"
        echo "3) Stop VR server"
        echo "4) WiVRn Dashboard"
        echo "5) Connect headset over USB"
        echo "6) Pair new headset (Wi-Fi)"
        echo "7) Launch VPinball Example Table"
        echo "8) Show server log"
        echo "q) Back"
        echo "=============================="
        choose
        case "$choice" in
            [2-8])
                if [ "$vrok" = 0 ]; then
                    echo "VR components not installed, run VR > Setup first."
                    sleep 2
                    continue
                fi
                ;;
        esac
        case "$choice" in
            1) vr_setup_submenu ;;
            2) action_vr_start ;;
            3) action_vr_stop ;;
            4) action_vr_dashboard ;;
            5) action_vr_connect_usb ;;
            6) action_vr_pair ;;
            7) action_vr_example_table ;;
            8) action_vr_log ;;
            q|Q) return ;;
            *) invalid ;;
        esac
    done
}

# On a live session, whether its settings survive a reboot.
live_settings_note() {
    case "$(persistence_state)" in
        none)
            echo "Settings are lost on reboot. To keep them, pick"
            echo "\"save settings to USB\" at the boot menu."
            ;;
        *) persistence_message ;;
    esac
    echo
}

confirm() {
    printf "%s [y/N]: " "$1"
    read -r answer
    case "$answer" in
        y|Y) return 0 ;;
        *) return 1 ;;
    esac
}

while true; do
    clear
    print_logo
    echo "            Main"
    echo "=============================="
    if ! is_installed; then
        live_settings_note
    fi
    echo "1) Setup"
    if is_installed; then
        echo "2) VPinFE"
        echo "3) VR"
        echo "4) Update VPinOS"
        echo "5) Testing"
        echo "6) Tools"
    else
        echo "2) Testing"
        echo "3) VR"
        echo "4) Install VPinOS"
        echo "5) Tools"
    fi
    echo "q) Quit to shell"
    echo "s) Shutdown"
    echo "r) Reboot"
    echo "=============================="
    choose

    case "$choice" in
        1) setup_submenu ;;
        2) if is_installed; then action_vpinfe; else testing_submenu; fi ;;
        3) vr_submenu ;;
        4)
            if is_installed; then
                action_update
                # The update may have replaced this script (vpinos-core);
                # restart so the menu is the new version, not the old
                # one still running from the replaced file.
                exec /usr/bin/vpinos-menu
            else
                action_install
            fi
            ;;
        5) if is_installed; then testing_submenu; else tools_submenu; fi ;;
        6) if is_installed; then tools_submenu; else invalid; fi ;;
        q|Q) break ;;
        s|S)
            if confirm "Shut down now?"; then
                action_shutdown
            else
                log "selected shutdown, cancelled"
            fi
            ;;
        r|R)
            if confirm "Reboot now?"; then
                action_reboot
            else
                log "selected reboot, cancelled"
            fi
            ;;
        *) invalid ;;
    esac
done
