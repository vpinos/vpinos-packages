#!/bin/sh
# Prints the folder Visual Pinball keeps its settings in (VPinballX.ini,
# directoutputconfig/, ...) for the installed version, e.g.
# ~/.local/share/VPinballX/10.9. It prints the path only and never creates it.
#
# VPX uses one folder per minor version (10.8, 10.9, ...). The first time a
# new minor version runs and finds no folder of its own, it copies the newest
# older folder into a new one. If anything else creates that folder first,
# VPX skips the copy and the user loses their settings. So the version comes
# from the installed package, and callers let VPX create the folder (running
# VPinballX_BGFX -h is enough).
#
# Order: the vpinball package's major.minor, then the newest existing
# version folder, then 10.9.

base="${XDG_DATA_HOME:-$HOME/.local/share}/VPinballX"

# "1:10.9.0-6984-98d8de7f4-1" -> "10.9"
version=$(dpkg-query -W -f='${Version}' vpinball 2>/dev/null \
    | sed -nE 's/^([0-9]+:)?([0-9]+\.[0-9]+)\..*/\2/p')

if [ -z "$version" ] && [ -d "$base" ]; then
    version=$(find "$base" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null \
        | grep -E '^[0-9]+\.[0-9]+$' | sort -V | tail -n 1)
fi

echo "$base/${version:-10.9}"
