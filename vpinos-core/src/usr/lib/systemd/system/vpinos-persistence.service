# Saves the live session's settings on the USB stick, when the boot
# entry "save settings to USB" was picked (`persistence` on the kernel
# command line). On the first such boot it makes the vpinos-data
# partition and puts its overlays in place; on later ones live-boot
# already has, and this only records that for the menus. See
# /usr/libexec/vpinos/vpinos-persistence.sh. Never runs on an installed
# system (no boot=live).
#
# Before the menu (tty1's autologin), NetworkManager, and the services
# that read /etc/vpinos, so they all see the saved settings -- on the
# first boot nothing has the saved directories open when the overlays go
# over them.
[Unit]
Description=VPinOS: save live-session settings on the USB stick
ConditionKernelCommandLine=boot=live
ConditionKernelCommandLine=persistence
After=local-fs.target live-config.service systemd-udevd.service systemd-udev-trigger.service
Before=getty@tty1.service kmsconvt@tty1.service NetworkManager.service vpinos-console-rotation.service vpinos-fetch-tables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/vpinos/vpinos-persistence.sh setup
# Formatting a large, slow stick can take a while on the first boot.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
