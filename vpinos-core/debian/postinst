#!/bin/sh
set -e

DEFAULTS=/usr/share/vpinos/defaults
STAMPS=/var/lib/vpinos-core/seeded

# Places one default from $DEFAULTS at its real path -- once, ever. A
# stamp under $STAMPS records that it was placed, so later upgrades
# never touch it again: not when it's been edited, and not when the
# user deleted it. If the path already exists (and was never stamped)
# it is left exactly as is and only stamped. These are not conffiles;
# dpkg doesn't track them at all. A default added in a future version
# has no stamp yet, so it still gets placed once on existing cabinets.
#
# seed <path> <owner:group> [mode]   (mode only for plain files)
seed() {
    dest=$1
    owner=$2
    mode=$3
    stamp=$STAMPS$dest
    [ -e "$stamp" ] && return 0
    if [ ! -e "$dest" ]; then
        cp -a "$DEFAULTS$dest" "$dest"
        chown -R "$owner" "$dest"
        [ -n "$mode" ] && chmod "$mode" "$dest"
    fi
    mkdir -p "$(dirname "$stamp")"
    touch "$stamp"
}

case "$1" in
    configure)
        mkdir -p /etc/vpinos
        # hyprland-installer.conf is no longer seeded: hyprland.conf's
        # windowed mode replaced it. Cabinets seeded before that keep
        # their copy, and vpinos-launch still falls back to it while
        # their hyprland.conf has no windowed mode.

        if getent passwd vpinos >/dev/null; then
            # Written directly by vpinos-menu (boot-mode, gpu-driver,
            # console-rotation) and
            # vpinos-config (hyprland.conf's monitor block,
            # table-rotation.conf) as `vpinos`,
            # no sudo -- user-facing choices, not a privilege boundary.
            seed /etc/vpinos/boot-mode vpinos:vpinos 0644
            seed /etc/vpinos/gpu-driver vpinos:vpinos 0644
            seed /etc/vpinos/console-rotation vpinos:vpinos 0644
            seed /etc/vpinos/hyprland.conf vpinos:vpinos 0644
            seed /etc/vpinos/table-rotation.conf vpinos:vpinos 0644

            home=$(getent passwd vpinos | cut -d: -f6)
            if [ -d "$home" ]; then
                install -d -o vpinos -g vpinos "$home/.config" \
                    "$home/.config/vpinfe" "$home/.config/vpinfe/themes"
                seed "$home/.config/vpinfe/vpinfe.ini" vpinos:vpinos 0644
                seed "$home/.config/vpinfe/themes/Revolution" vpinos:vpinos
            fi

            # The menu, launcher and fetch service append to these as
            # `vpinos`; a non-root process can append to an existing
            # writable file in /var/log but can't create one there.
            for log in vpinos-launch vpinos-hyprland vpinos-menu vpinos-tables; do
                if [ ! -e "/var/log/$log.log" ]; then
                    touch "/var/log/$log.log"
                    chown vpinos:vpinos "/var/log/$log.log"
                fi
            done
        else
            echo "vpinos-core: no 'vpinos' user -- skipping the cabinet defaults that belong to it" >&2
        fi

        # tty1's console is kmscon (/usr/libexec/vpinos/vpinos-kmscon),
        # not agetty: getty.target starts kmsconvt@tty1 instead of
        # getty@tty1. The getty@tty1 drop-ins (ours and live-config's)
        # stay -- getty@tty1 is still kmsconvt@'s OnFailure= fallback.
        # Plain symlinks, the same ones `systemctl enable/disable` would
        # write, so this also works in the image build's chroot. Other
        # VTs keep agetty: each kmscon would hold the GPU open.
        # On a running cabinet the switch happens at the next boot -- the
        # menu's "A reboot is needed" after Update VPinOS says so.
        wants=/etc/systemd/system/getty.target.wants
        mkdir -p "$wants"
        if [ ! -e "$wants/kmsconvt@tty1.service" ] && [ -d /run/systemd/system ]; then
            touch /run/reboot-required 2>/dev/null || true
        fi
        rm -f "$wants/getty@tty1.service"
        ln -sf /usr/lib/systemd/system/kmsconvt@.service "$wants/kmsconvt@tty1.service"

        # ModemManager (pulled in by network-manager's Recommends) is
        # only for cellular modems, which a cabinet never has, and it
        # probes USB serial boards (DOF controllers) with AT commands.
        # Masked rather than removed: `apt upgrade` can't remove a
        # package. Once, ever (stamped like seed), so a `systemctl
        # unmask` survives later upgrades. The plain symlink is what
        # `systemctl mask` writes, so this also works in the chroot.
        if [ ! -e "$STAMPS/modemmanager-masked" ]; then
            if [ -d /run/systemd/system ]; then
                systemctl stop ModemManager.service 2>/dev/null || true
            fi
            ln -sf /dev/null /etc/systemd/system/ModemManager.service
            mkdir -p "$STAMPS"
            touch "$STAMPS/modemmanager-masked"
        fi

        # Pick up the getty/ssh drop-ins and the ModemManager mask
        # without a reboot.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi

        # Apply 70-vpinos-usb-open.rules to boards that are already
        # plugged in. Skipped in the image build's chroot (no running
        # udev).
        if [ -S /run/udev/control ]; then
            udevadm control --reload-rules || true
            udevadm trigger --subsystem-match=usb --subsystem-match=tty \
                --subsystem-match=hidraw || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
