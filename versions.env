# The kernel and NVIDIA driver every VPinOS cabinet runs -- the one place
# these are set. Read by build-platform.sh. Changing anything here is a
# platform bump: see "Upgrading the kernel or NVIDIA driver" in README.md
# (and notes/skills/upgrade-kernel-nvidia in the VPinOS workspace notes).

# vpinos-platform's own version. Bump it on EVERY platform release, even
# if only one of the values below changed; the release tag is
# platform-v<this>.
PLATFORM_VERSION=1.0.4

# snapshot.debian.org timestamp of the frozen trixie-backports the kernel,
# Mesa, firmware and Hyprland come from. Must match
# vpinos-platform/apt/vpinos-backports.list.
SNAPSHOT=20261002T203108Z

# Kernel ABI (amd64 package: linux-image-${KERNEL_ABI}-amd64). Must exist
# in the snapshot above. arm64 follows linux-image-arm64 from the same
# snapshot.
KERNEL_ABI=7.1.13+deb13

# NVIDIA driver from NVIDIA's apt repo (amd64 only). NVIDIA_DEB_VERSION is
# the full Debian version the userspace packages and nvidia-kernel-open-dkms
# carry. Must match the version pin in vpinos-platform/apt/vpinos-nvidia-repo.pref.
NVIDIA_VERSION=615.71.09
NVIDIA_DEB_VERSION=615.71.09-2

# The NVIDIA userspace packages a cabinet gets, all held at exactly
# NVIDIA_DEB_VERSION by vpinos-nvidia-modules' Depends (everything the
# nvidia-driver metapackage pulls in, minus the DKMS/compiler side).
NVIDIA_USERSPACE="nvidia-driver-libs nvidia-kernel-support nvidia-modprobe nvidia-powerd nvidia-egl-icd nvidia-vulkan-icd nvidia-vdpau-driver xserver-xorg-video-nvidia firmware-nvidia-gsp libnvidia-cfg1 libnvidia-api1 libnvidia-ngx1"

# NVIDIA legacy driver: the last branch for Maxwell, Pascal and Volta
# (GTX 750 to 10-series, Titan V), which the current driver above no
# longer supports. amd64 only. NVIDIA's debian13 apt repo has no 580, so
# it comes from NVIDIA's .run installer:
#   https://download.nvidia.com/XFree86/Linux-x86_64/<version>/NVIDIA-Linux-x86_64-<version>.run
# build-platform.sh refuses a download whose sha256 doesn't match
# (compare against NVIDIA's own <file>.sha256sum when bumping). Installed
# side by side with the current driver under /usr/lib/vpinos/nvidia-legacy,
# chosen per cabinet in Setup > GPU Driver (notes/nvidia-legacy-plan.md).
# NVIDIA_LEGACY_REVISION is vpinos-nvidia-legacy's packaging revision:
# bump it for a packaging-only change, reset it to 1 on a version bump.
NVIDIA_LEGACY_VERSION=580.196.07
NVIDIA_LEGACY_SHA256=0aab0518db53cf73c412dc7f32bbc850ca95e839d8923d0de4bff42c1c9169ce
NVIDIA_LEGACY_REVISION=1
